
# TaskForge Environment Configuration
# Copy this file to .env and configure values for your environment.
# Never commit .env or real credentials to Git.

# Application
APP_ENV=development
DEBUG=true

# Django secret key
# Generate a unique secret for each deployment.
SECRET_KEY=replace-with-generated-secret

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL configuration
# Required when APP_ENV=production.
# Not used by the current SQLite development configuration.
DB_NAME=taskforge
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=replace-with-database-host
DB_PORT=5432
